{
  "name": "genomics-caddy",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ./scripts/run_tsc.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "node ./scripts/run_tsc.mjs --noEmit",
    "lint": "node ./scripts/run_tsc.mjs --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "check": "node ./scripts/run_svelte_check.mjs",
    "check:watch": "node ./scripts/run_svelte_check.mjs --watch",
    "clean:deep": "node -e \"const fs=require('fs'); for (const p of ['node_modules','package-lock.json','dist','.svelte-kit']) fs.rmSync(p,{recursive:true,force:true});\"",
    "clean:fresh": "npm run clean:deep && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "python scripts/smoke_test.py",
    "mcp": "tauri dev -- --mcp",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -W clippy::pedantic -D warnings",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
    "update:all": "node ./scripts/update_all.mjs",
    "update:all:dry": "node ./scripts/update_all.mjs --dry-run",
    "update:toolchains": "node ./scripts/update_all.mjs --skip-npm --skip-cargo --skip-verify",
    "update:deps": "node ./scripts/update_all.mjs --skip-toolchains",
    "system:check": "bash ./scripts/system_check.sh",
    "setup:linux": "bash ./scripts/setup_linux_deps.sh",
    "desktop:linux": "bash ./scripts/install_linux_desktop.sh",
    "verify:css": "node ./scripts/verify_vite_css_load.mjs",
    "icons:regen": "tauri icon ./static/logo.png",
    "build:release": "node ./scripts/run_release_build.mjs",
    "build:release-fast": "node ./scripts/run_release_build.mjs --skip-purge",
    "purge:build": "node ./scripts/run_release_build.mjs --purge-only",
    "bench:purge": "node ./scripts/run_benchmark_build.mjs --purge-only --json",
    "bench:rebuild": "node ./scripts/run_benchmark_build.mjs --json",
    "bench:rebuild:fast": "node ./scripts/run_benchmark_build.mjs --skip-checks --json",
    "build:remote:mac": "python scripts/build.py --target mac",
    "build:remote:linux": "python scripts/build.py --target linux",
    "build:remote:windows": "python scripts/build.py --target windows",
    "build:remote:all": "python scripts/build.py --target all",
    "build:remote:mac:clean": "python scripts/build.py --target mac --clean",
    "build:remote:linux:clean": "python scripts/build.py --target linux --clean",
    "build:remote:lint": "python scripts/build.py --target mac linux --lint-only"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "isomorphic-dompurify": "^3.18.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "cookie": "1.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
