{
  "name": "Dietary Requirements & Food Decision Rules",
  "version": "1.0.0",
  "last_updated": "2026-07-06",
  "type": "support_engine",
  "purpose": "Convert genetics, labs, symptoms, medical conditions, allergies, medications, values, religion/culture and user preference into food-level allow/avoid/emphasize/substitute decisions.",
  "critical_design_rule": "Food requirements are not inferred from DNA unless the rule explicitly uses genotype as one weak input. Allergy, medical diagnosis, medication safety, pregnancy, kidney disease, and user-declared values override nutrigenomic optimization.",
  "priority_order": [
    "anaphylaxis/allergy safety",
    "medication interaction / clinical contraindication",
    "diagnosed disease requirement such as celiac or CKD",
    "pregnancy/lactation safety",
    "religious/cultural/ethical requirement",
    "clinician-directed therapeutic diet",
    "lab-confirmed deficiency/excess",
    "symptom-confirmed intolerance",
    "genotype-informed optimization",
    "general preference"
  ],
  "rules": [
    {
      "id": "RULE_ALLERGY_MAJOR_FOOD_STRICT_AVOIDANCE",
      "label": "Major food allergen strict avoidance",
      "trigger_sources": [
        "self_reported_allergy",
        "clinician_diagnosis",
        "allergy_testing",
        "anaphylaxis_history"
      ],
      "rule_type": "strict_avoid",
      "priority": 100,
      "applies_to_food_tags": [
        "milk",
        "egg",
        "fish",
        "crustacean_shellfish",
        "tree_nut",
        "peanut",
        "wheat",
        "soy",
        "sesame"
      ],
      "recommendation": "If a user reports a confirmed allergy to a major allergen, remove that allergen and likely cross-contact foods from meal suggestions. Do not override allergy avoidance with genetic or nutrient recommendations.",
      "substitutions": [
        "use allergen-specific substitutes",
        "prefer certified allergen-free products when reaction history is severe",
        "route unclear cases to clinician/allergist"
      ],
      "confirm_with": [
        "allergist evaluation",
        "skin-prick testing",
        "serum specific IgE",
        "supervised oral food challenge when appropriate"
      ],
      "do_not_claim": [
        "genetics diagnoses allergy",
        "absence of allergy from genotype",
        "safe reintroduction after severe reaction"
      ],
      "relevant_pack_signals": [
        "allergy_atopy_mast_cell",
        "digestive_gut_microbiome"
      ],
      "conflict_resolution": "Allergy rules outrank nutrient optimization and dietary-pattern preferences.",
      "sources": [
        "fda_major_food_allergens",
        "usda_big_9_allergens"
      ]
    },
    {
      "id": "RULE_FISH_ENCOURAGED_PORK_AVOIDED",
      "label": "Fish encouraged while pork avoided",
      "trigger_sources": [
        "user_preference",
        "religious_requirement",
        "cultural_requirement",
        "medical_nutrition_goal"
      ],
      "rule_type": "allowed_emphasize_and_exclude",
      "priority": 72,
      "applies_to_food_tags": [
        "fish",
        "seafood",
        "pork",
        "processed_pork"
      ],
      "recommendation": "When the user marks fish as acceptable/desired and pork as prohibited, recommend low-mercury fish and seafood for EPA/DHA, iodine, selenium, B12 and protein while excluding pork, bacon, ham, lard, gelatin-from-pork, pork sausage, and pork-derived broths where relevant.",
      "substitutions": [
        "salmon",
        "sardines",
        "trout",
        "herring",
        "anchovies",
        "cod",
        "eggs",
        "poultry",
        "beans/lentils if tolerated",
        "soy/tofu if tolerated",
        "algal EPA/DHA if fish not tolerated"
      ],
      "confirm_with": [
        "user's reason for pork avoidance",
        "fish/shellfish allergy status",
        "mercury/pregnancy status",
        "religious strictness level",
        "whether gelatin/enzymes/broth cross-contact matters"
      ],
      "do_not_claim": [
        "DNA determines religious food requirements",
        "fish is required for every user",
        "all seafood is low mercury"
      ],
      "relevant_pack_signals": [
        "nutrients",
        "cardiovascular",
        "metabolic",
        "allergy_atopy_mast_cell"
      ],
      "conflict_resolution": "If fish allergy exists, fish emphasis is disabled and algal EPA/DHA or other substitutes are suggested.",
      "sources": [
        "nih_ods_omega3",
        "dietary_guidelines_2025_2030"
      ]
    },
