      ],
      "red_flags": [
        "resting shortness of breath",
        "low oxygen",
        "witnessed apneas",
        "hemoptysis"
      ],
      "confirmations": [
        "spirometry",
        "sleep study",
        "serum AAT if indicated",
        "pulmonology review"
      ]
    },
    {
      "id": "immune_autoimmune_general",
      "trigger": [
        "HLA tags",
        "PTPN22",
        "CTLA4",
        "autoimmune panels"
      ],
      "questions": [
        "Joint swelling, rashes, mouth ulcers, fevers, gut inflammation, thyroid symptoms, neurologic episodes?",
        "Family history of autoimmune disease?"
      ],
      "red_flags": [
        "neurologic deficits",
        "severe joint swelling",
        "persistent fever",
        "organ-specific symptoms"
      ],
      "confirmations": [
        "autoantibodies",
        "CRP/ESR",
        "organ-specific labs",
        "specialist review"
      ]
    },
    {
      "id": "pain_migraine_sensory",
      "trigger": [
        "migraine loci",
        "pain channelopathy panel",
        "COMT/OPRM1/FAAH"
      ],
      "questions": [
        "Migraine pattern, aura, photophobia, nausea, triggers, pain sensitivity, medication response?",
        "Taste/smell/sensory sensitivities or neuropathic pain?"
      ],
      "red_flags": [
        "worst headache of life",
        "new neurologic deficit",
        "headache with fever/neck stiffness"
      ],
      "confirmations": [
        "headache diary",
        "neurology review if red flags",
        "medication history"
      ]
    }
  ]
}