.DS_Store
node_modules
/build
/builds/
/.svelte-kit
/package
.env
.env.*
!.env.example

# Local data & temporary scratch script caches
/data/*
!/data/.gitkeep
!/data/references/.gitkeep
/scratch/
screenshot.png
*.log
tmp_error.log

# Portable release staging and persistent local app data are generated locally.
/App/
# Ignore runtime databases in any app-data root, including SQLite sidecars.
**/App/Data/**/*.db
**/App/Data/**/*.db-*
**/App/Data/**/*.sqlite
**/App/Data/**/*.sqlite-*
**/App/Data/**/*.sqlite3

# Runtime downloads, imported samples, and chain/reference caches beside the
# tracked marker-pack mirror. Keep src-tauri/App/Data/marker-packs/ tracked.
/src-tauri/App/Data/raw_downloads/
/src-tauri/App/Data/samples/
/src-tauri/App/Data/references/

# Personal genomic raw data, sequencing files, and generated reports.
# Synthetic parser fixtures under src-tauri/testdata/ are the exception.
*.txt
!*README*.txt
!*COPY*.txt
!LICENSE*.txt
!/src-tauri/testdata/
!/src-tauri/testdata/*.txt
*DNA*.txt
AncestryDNA.txt
23andMe*.txt
*.zip
*.csv
!/src-tauri/testdata/*.csv
*.tsv
!/src-tauri/testdata/*.tsv
*.vcf
*.vcf.gz
*.vcf.bgz
*.bcf
*.bed
*.bim
*.fam
*.ped
*.map
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.bam
*.cram
*.sam
*.pdf
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*report.json
*_report*.json
*_report.md
*_handoff.json
*_handoff.md

# Tooling / OS noise
__pycache__/
*.pyc
.idea/
.vscode/*.log
.playwright-cli/
output/playwright/
/output/

# Local memory and dated planning notes may contain user-specific context.
/MEMORY.md
/MEMORY.local.md
/*_tasklist.md
/*_strategy.md
/Toolkit_Enhancement_Plan.md

# Dependency lockfiles are intentionally not retained for local build testing.
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lock
bun.lockb
npm-shrinkwrap.json
src-tauri/Cargo.lock
