    {
      "id": "triglyceride_liver_context",
      "genes": [
        "GCKR",
        "APOA5",
        "PNPLA3",
        "TM6SF2"
      ],
      "actionability_class": "symptom_or_lab_conditioned",
      "pack_hints": [
        "metabolic",
        "cardiovascular"
      ],
      "favor": [
        "A balanced, fiber-forward eating pattern and regular movement",
        "If triglycerides or liver tests are elevated, discuss reducing sugar-sweetened beverages and frequent alcohol exposure"
      ],
      "avoid": [
        "Assuming normal blood lipids rule out fatty-liver susceptibility",
        "Using detox products or high-dose supplements as liver treatment"
      ],
      "lab_tests": [
        {
          "name": "Fasting lipid panel including triglycerides",
          "urgency": "consider"
        },
        {
          "name": "HbA1c",
          "urgency": "consider"
        },
        {
          "name": "ALT/AST/GGT liver panel",
          "urgency": "consider"
        },
        {
          "name": "Liver ultrasound or FibroScan when clinically indicated",
          "urgency": "consider"
        }
      ],
      "notes": "GCKR, APOA5, PNPLA3, and TM6SF2 findings can point to different lipid, glucose, and liver phenotypes. They do not diagnose fatty liver, steatohepatitis, pancreatitis, or diabetes; measured labs and clinical evaluation lead.",
      "sources": [
        "gwas_catalog",
        "cdc_prediabetes_lifestyle",
        "niddk_prediabetes_tests",
        "niddk_fatty_liver_diagnosis",
        "lab_confirmation_required"
