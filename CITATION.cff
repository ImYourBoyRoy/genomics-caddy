    website: https://github.com/ImYourBoyRoy
repository-code: https://github.com/ImYourBoyRoy/genomics-caddy
url: https://github.com/ImYourBoyRoy/genomics-caddy
license: PolyForm-Noncommercial-1.0.0
keywords:
