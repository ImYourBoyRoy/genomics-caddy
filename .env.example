# Genomics Caddy — local configuration

# Copy this file to `.env` beside the application executable (see Advanced Settings → App Data Paths).

# NEVER commit `.env` — it may contain secrets.



# Qdrant vector database (optional — can also be set in Advanced Settings UI)

QDRANT_URL=http://localhost:6333

QDRANT_API_KEY=

QDRANT_COLLECTION=genomics_evidence



# NCBI E-utilities (optional — increases rate limits for PubMed/ClinVar lookups)

NCBI_API_KEY=



# Ollama embedding server (optional — default http://localhost:11434 when unset)

OLLAMA_URL=http://localhost:11434

OLLAMA_TOKEN=



# Optional agent UI / Vite loopback (local QA only). The desktop app binds
# 127.0.0.1 with an ephemeral port and writes a 0600 endpoint file.
# Do not set these to LAN/cloud hosts. Prefer `pnpm run agent-ui:url`.
# GENOMICS_AGENT_UI=1
# GENOMICS_AGENT_UI_TOKEN=
# GENOMICS_AGENT_UI_PORT=
# GENOMICS_AGENT_UI_URL=http://127.0.0.1:PORT



# Remote Apple compile (optional — scripts/sync_dna_to_server.py + smoketest_macos.sh)
# Toolkit-native keys only. Paths must stay under dna_tools (never biolume).
# REMOTE_HOST=builder.example.net
# REMOTE_USER=builder-user
# REMOTE_DIR=/home/builder-user/dna_tools
# VM_HOST=macos-guest.example.net
# VM_USER=guest-user
# VM_SSH_KEY=~/.ssh/id_ed25519
# VM_NAME=macOS
# VM_MAC=00:00:00:00:00:00
# GUEST_DIR=/Users/guest-user/dna_tools



# Vector Research pipeline tuning (optional)

# Dynamic tuning from CPU count + measured Ollama/Qdrant latency (default). Set GENOMICS_TUNING=fixed to use manual env overrides only.

# GENOMICS_CPU_LIMIT=80   # optional host core count override; tuning uses (limit − 1) cores

# GENOMICS_TUNING=dynamic

# Fast bulk sweep (also toggled in Vector Research → Sweep Scopes UI): local GWAS + embed only — often 5–20× faster.

# GENOMICS_SWEEP_FAST=1

# GENOMICS_ENRICH_BATCH_SIZE=32

# GENOMICS_PREPARE_CONCURRENCY=24

# GENOMICS_EMBED_PARALLEL=6

# GENOMICS_PIPELINE_DEPTH=2

# GENOMICS_GWAS_API_CONCURRENCY=12

# GENOMICS_GNOMAD_CONCURRENCY=16

# GENOMICS_SKIP_GNOMAD=1

