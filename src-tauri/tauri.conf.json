{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genomics Caddy",
  "version": "0.2.7",
  "identifier": "com.dna.explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Genomics Caddy",
        "width": 800,
        "height": 600,
        "maximized": true,
        "backgroundColor": "#080b14"
      }
    ],
    "enableGTKAppId": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3Q0M4MUU1OUE3Mjc5ODEKUldTQmVYS2E1WUhNUjhGbmRPQkJKNHdTVWZ1dno5ekk0NHZXSWNzVEtNUGRadjhnNS9XUDMyR3QK",
      "endpoints": [
        "https://github.com/ImYourBoyRoy/genomics-caddy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "desktop.template",
        "postInstallScript": "linux/post_install.sh",
        "postRemoveScript": "linux/post_remove.sh"
      },
      "rpm": {
        "desktopTemplate": "desktop.template",
        "postInstallScript": "linux/post_install.sh",
        "postRemoveScript": "linux/post_remove.sh"
      }
    }
  }
}
