    {
      "id": "glucose_insulin_context",
      "genes": [
        "FTO",
        "PPARG",
        "TCF7L2",
        "SLC30A8",
        "KCNJ11",
        "GCKR"
      ],
      "actionability_class": "symptom_or_lab_conditioned",
      "pack_hints": [
        "metabolic"
      ],
      "favor": [
        "A balanced eating pattern built around fiber-rich foods, adequate protein, and minimally processed carbohydrate sources",
        "Regular physical activity progressed gradually to fit current ability, symptoms, and recovery"
      ],
      "avoid": [
        "Treating a common metabolic SNP as a diabetes diagnosis or as a reason to start medication",
        "Using a highly restrictive diet to chase a genotype without symptom, lab, medication, or clinician context"
      ],
      "lab_tests": [
        {
          "name": "HbA1c",
          "urgency": "consider"
        },
        {
          "name": "Fasting plasma glucose",
          "urgency": "consider"
        }
      ],
      "notes": "Common metabolic markers shift average risk by small or context-dependent amounts. Use symptoms, family history, body-composition context, medications, and laboratory testing rather than a SNP to assess glucose status.",
