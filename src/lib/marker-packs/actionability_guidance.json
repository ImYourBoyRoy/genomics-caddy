        "metabolic"
      ],
      "favor": [
        "Use a heart-healthy eating pattern and regular activity as general cardiovascular foundations",
        "Review measured Lp(a), ApoB, LDL-C, triglycerides, blood pressure, and family history together rather than reading one SNP in isolation"
      ],
      "avoid": [
        "Assuming a protective-leaning LDL-pathway marker removes the need for lipid monitoring",
        "Using a genotype as a substitute for measured lipids and global cardiovascular-risk assessment"
      ],
      "medication_context": [
        "Do not start, stop, or change a statin, PCSK9 medicine, aspirin, or other cardiovascular therapy from raw DNA; review measured Lp(a), ApoB, LDL-C, medical history, and clinician guidance."
      ],
      "lab_tests": [
        {
          "name": "Lipoprotein(a) [Lp(a)] blood test (at least once if not previously measured)",
          "urgency": "consider"
        },
        {
          "name": "ApoB (Apolipoprotein B)",
          "urgency": "consider"
        },
        {
          "name": "Standard lipid panel (LDL-C, HDL-C, triglycerides)",
          "urgency": "consider"
        },
        {
          "name": "Blood pressure measurement",
          "urgency": "routine"
        }
      ],
      "notes": "LPA and LDL-pathway markers can suggest a reason to check the phenotype, but they do not quantify risk or determine treatment. Lp(a), ApoB, LDL-C, triglycerides, blood pressure, family history, and clinical risk assessment remain decisive.",
      "sources": [
