.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example

# Local data & temporary scratch script caches
/data/*
!/data/.gitkeep
!/data/references/.gitkeep
/scratch/
screenshot.png
*.log
tmp_error.log

# App distribution artifacts & private databases
/App/*
!/App/
!/App/Data/
!/App/.gitkeep
!/App/Data/.gitkeep
/App/Data/**
!/App/Data/.gitkeep
# Never commit nested mistaken App/App trees or staged binaries
/App/App/
/App/DNA-Tools
/App/DNA-Tools.exe
/App/Genomics*
/App/Data/benchmarks/
/App/Data/samples/

# Personal genomic raw data files & report outputs
*.txt
!*README*.txt
!*COPY*.txt
*DNA*.txt
AncestryDNA.txt
23andMe*.txt
*.zip
*.csv
*report.json
roy_report.json
*_report*.json

# Tooling / OS noise
__pycache__/
*.pyc
.idea/
.vscode/*.log
