{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genomics Caddy",
  "version": "0.2.0",
  "identifier": "com.dna.explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Genomics Caddy",
        "width": 800,
        "height": 600,
        "maximized": true,
        "backgroundColor": "#080b14"
      }
    ],
    "enableGTKAppId": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop.template",
        "postInstallScript": "linux/post_install.sh",
        "postRemoveScript": "linux/post_remove.sh"
      },
      "rpm": {
        "desktopTemplate": "desktop.template",
        "postInstallScript": "linux/post_install.sh",
        "postRemoveScript": "linux/post_remove.sh"
      }
    }
  }
}
