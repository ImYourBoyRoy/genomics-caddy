{
  "name": "genomics-caddy",
  "version": "0.2.2",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ./scripts/run_tsc.mjs --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node ./scripts/run_tsc.mjs --noEmit",
    "lint": "node ./scripts/run_tsc.mjs --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "check": "node ./scripts/run_svelte_check.mjs",
    "check:watch": "node ./scripts/run_svelte_check.mjs --watch",
    "clean:deep": "node ./scripts/clean_deep.mjs",
    "clean:deep:fresh": "node ./scripts/clean_deep.mjs --fresh-dependencies",
    "clean:deep:dry": "node ./scripts/clean_deep.mjs --dry-run",
    "clean:fresh": "node ./scripts/clean_deep.mjs --fresh-dependencies && node ./scripts/pnpm_unlocked.mjs install",
    "install:unlocked": "node ./scripts/pnpm_unlocked.mjs install",
    "test": "npx svelte-kit sync && vitest run",
    "validate:packs": "node ./scripts/validate_marker_packs.mjs",
    "audit:resources": "node ./scripts/audit_resource_quality.mjs",
    "audit:content": "node ./scripts/audit_content_quality.mjs",
    "audit:markers": "node ./scripts/audit_marker_semantics.mjs",
    "audit:inflammation": "node ./scripts/audit_inflammation.mjs",
    "audit:reproducibility": "node ./scripts/audit_reproducibility.mjs",
    "audit:updater-config": "node ./scripts/audit_updater_config.mjs",
    "audit:dna-fixtures": "python3 ./scripts/audit_dna_fixtures.py",
    "audit:tauri-ui": "node ./scripts/audit_tauri_report.mjs",
    "agent-ui:url": "node ./scripts/print_agent_ui_endpoint.mjs",
    "audit:tauri-update": "node ./scripts/audit_tauri_update_flow.mjs",
    "audit:mcp": "node ./scripts/audit_mcp_runtime.mjs",
    "audit:mcp:write": "node ./scripts/audit_mcp_runtime.mjs --write-fixture",
    "test:watch": "vitest",
    "smoke": "python scripts/smoke_test.py",
    "mcp": "tauri dev -- --mcp",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -W clippy::pedantic -D warnings",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
    "update:all": "node ./scripts/update_all.mjs",
    "update:all:dry": "node ./scripts/update_all.mjs --dry-run",
    "update:toolchains": "node ./scripts/update_all.mjs --skip-npm --skip-cargo --skip-verify",
    "update:deps": "node ./scripts/update_all.mjs --skip-toolchains",
    "system:check": "bash ./scripts/system_check.sh",
    "setup:linux": "bash ./scripts/setup_linux_deps.sh",
    "desktop:linux": "bash ./scripts/install_linux_desktop.sh",
    "desktop:linux:uninstall": "bash ./scripts/uninstall_linux_desktop.sh",
    "desktop:linux:refresh": "bash ./scripts/refresh_linux_portable_ui.sh",
    "verify:css": "node ./scripts/verify_vite_css_load.mjs",
    "icons:regen": "tauri icon ./static/logo.png",
    "build:release": "node ./scripts/run_release_build.mjs",
    "build:release-fast": "node ./scripts/run_release_build.mjs --skip-purge",
    "purge:build": "node ./scripts/run_release_build.mjs --purge-only",
    "bench:purge": "node ./scripts/run_benchmark_build.mjs --purge-only --json",
    "bench:rebuild": "node ./scripts/run_benchmark_build.mjs --json",
    "bench:rebuild:fast": "node ./scripts/run_benchmark_build.mjs --skip-checks --json",
    "build:remote:mac": "python scripts/build.py --target mac",
    "build:remote:linux": "python scripts/build.py --target linux",
    "build:remote:windows": "python scripts/build.py --target windows",
    "build:remote:all": "python scripts/build.py --target all",
    "build:remote:mac:clean": "python scripts/build.py --target mac --clean",
    "build:remote:linux:clean": "python scripts/build.py --target linux --clean",
    "build:remote:lint": "python scripts/build.py --target mac linux --lint-only"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "isomorphic-dompurify": "4.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.1",
    "@typescript/typescript6": "6.0.2",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "cookie": "1.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
